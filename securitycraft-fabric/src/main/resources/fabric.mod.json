{
	"schemaVersion": 1,
	"id": "securitycraft",
	"version": "${version}",
	"name": "SecurityCraft",
	"description": "Adds a load of things to keep your house safe with and defend yourself from attackers. Unofficial Fabric port of SecurityCraft.",
	"authors": [
		"Geforce",
		"bl4ckscor3",
		"Redstone_Dubstep",
		"ChainmailPickaxe"
	],
	"contact": {
		"homepage": "https://github.com/Geforce132/SecurityCraft",
		"issues": "https://github.com/Geforce132/SecurityCraft/issues"
	},
	"license": "MIT",
	"icon": "sc_logo.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.geforcemods.securitycraft.SecurityCraft"
		],
		"client": [
			"net.geforcemods.securitycraft.SecurityCraftClient"
		],
		"jei_mod_plugin": [
			"net.geforcemods.securitycraft.compat.jei.SCJEIPlugin"
		],
		"jade": [
			"net.geforcemods.securitycraft.compat.hudmods.JadeDataProvider"
		]
	},
	"mixins": [
		"securitycraft.mixins.json",
		"securitycraft.fabric.core.mixins.json",
		"securitycraft.fabric.inventory.mixins.json",
		"securitycraft.fabric.blocks.mixins.json",
		"securitycraft.fabric.events.mixins.json",
		"securitycraft.fabric.client.mixins.json",
		"securitycraft.fabric.camera.mixins.json",
		"securitycraft.fabric.items.mixins.json"
	],
	"accessWidener": "securitycraft.accesswidener",
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*",
		"forgeconfigapiport": "*"
	},
	"suggests": {
		"jei": "*",
		"jade": "*"
	}
}
